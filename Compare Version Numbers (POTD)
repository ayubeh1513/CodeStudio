import java.util.* ;
import java.io.*; 
import java.math.BigInteger;

public class Solution
{
    public static int compareVersions(String a, String b) 
    {
        // Write your code here
        String[] as = a.split("\\.");
        String[] bs = b.split("\\.");

        int n = Math.max(as.length, bs.length);

        for(int i=0; i<n; i++){

            BigInteger av = i < as.length ? new BigInteger(as[i]) : BigInteger.ZERO;
            BigInteger bv = i < bs.length ? new BigInteger(bs[i]) : BigInteger.ZERO;

            int c = av.compareTo(bv);
            if(c!=0) return c>0 ? 1 : -1;
        }

        return 0;
    }
}
