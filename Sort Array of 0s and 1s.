import java.util.* ;
import java.io.*; 
public class Solution {
  
    public static void sort0and1(int n, int[] A) {
        // Write your Code here
        int st = 0;
        for(int i : A){
            if(i==0) st++;
        }

        for(int i=0; i<n; i++){
            if(i<st) A[i] = 0;
            else A[i] = 1;
        }
    }
}
