import java.util.* ;
import java.io.*; 

public class Solution {
	public static String[] printPatt(int n) {
		// Write your code here
		int k = 0;
		String[] a = new String[n];
		for(int i=0; i<n; i++){
			StringBuilder sb = new StringBuilder();
			for(int j=0; j<n-i; j++){
				sb.append("*");
			} 
			
			// for(int j=0; j<i; j++){
			// 	sb.append(" ");
			// }

			a[k] = sb.toString();
			k++;
		}

		return a;
	}
}
