import java.util.*;
public class Solution {
	
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int a=n, b=0;

		while(n>0){
			int c = n%10;
			b *= 10;
			b += c;
			n /= 10;
		}

		if(a==b) System.out.print(true);
		else System.out.print(false);
	}
}
