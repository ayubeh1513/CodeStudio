import java.util.* ;
import java.io.*; 
public class Solution {

    public static int maximumWeightRow(int n, int m, int[][] mat) {
        // Write your code here.
        int a = 0;
        for(int i=0; i<n; i++){
            int b = 0;
            for(int j=0; j<m; j++){
                b += mat[i][j];
            }
            a = Math.max(a, b);
        }
        return a;
    }
}
