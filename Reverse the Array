import java.util.* ;
import java.io.*; 
import java.util.ArrayList;

public class Solution 
{
    public static void reverseArray(ArrayList<Integer> arr, int m)
    {
        // Write your code here.
        int n = arr.size();
        ArrayList<Integer> arrr = new ArrayList<>();
        for(int i=0; i<=m; i++){
            arrr.add(arr.get(i));
        }

        for(int i=n-1; i>m; i--){
            arrr.add(arr.get(i));
        }

        for(int i = 0; i < n; i++){
            arr.set(i, arrr.get(i));
        }
    }
}
