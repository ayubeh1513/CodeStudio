import java.util.*;

public class Main {
    
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int x = sc.nextInt();

        int count = 0;  
        int N = 1;       

        while(count < x) {
            int term = 3 * N + 2;

            if(term % 4 != 0) {
                System.out.print(term + " ");
                count++;
            }

            N++;
        }

        sc.close();
    }
}
