import java.util.* ;
import java.io.*; 
public class Solution {
  public static int hotelBookings(List<String> queries)
  {
      // Write your code here.
      int c = 0;
      for(int i=0; i<queries.size(); i++){
        String a = queries.get(i);
        if(a.charAt(0)=='+'){
          c++;
        }
      }
      return c;
  }
}
