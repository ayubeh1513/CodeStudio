import java.util.*;

public class Main {
	
	public static void main(String[] args) {
		// Write your code here

		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();

		int a = 1;
		int num = 0;
		while(n>0){
			int k = n%10;
			num = num + k*a;
			a *= 2;
			n /= 10;
		}

		System.out.println(num);
	}
}
