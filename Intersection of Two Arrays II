import java.util.*;
public class Solution{  
    
    public static void intersections(int arr1[], int arr2[]) {
    	//Your code goes here
        Map<Integer, Integer> m = new HashMap<>();
        for(int i : arr2){
            if(m.containsKey(i)){
                m.put(i, m.get(i) + 1);
            } else{
                m.put(i, 1);
            }
        }

        for(int i : arr1){
            if(m.containsKey(i) && m.get(i)>0){
                System.out.print(i + " ");
                m.put(i, m.get(i) - 1);
            }
        }
    }
}
