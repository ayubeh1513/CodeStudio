import java.util.* ;
import java.io.*; 
public class Solution {

	public static long sumOrProduct(int n, int q) {

		// Write your code here
		long m = 1000000007;
		if(q==1){
			long s = (n * (n+1)) / 2;
			return s;
		} else {
			long s = 1;
			for(int i=1; i<=n; i++){
				s = i*s % m;
			}
			return s;
		}
	}
}
