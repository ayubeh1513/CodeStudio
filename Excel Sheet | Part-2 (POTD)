import java.util.* ;
import java.io.*; 
public class Solution {
    public static long titleToNumber(String str)
    {
        long sum = 0;
        long poe = 0;

        for(int i=str.length()-1; i>=0; i--){
            long temp = (long) str.charAt(i)-64;
            sum = sum + (long) Math.pow(26, poe++) * temp;
        }

        return sum;
    }
}
