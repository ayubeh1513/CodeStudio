import java.util.*;

public class Solution {
	public static void main(String[] args) {
		//Your code goes here
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();

		for(int i=n; i>=1; i--){
			for(int j=i; j<=n; j++){
				char a = (char) (j+64);
				System.out.print(a);
			}
			System.out.println();
		}
	}
}
