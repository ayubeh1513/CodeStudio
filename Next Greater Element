public class Solution {
    public static int[] nextGreaterElement(int[] arr, int n) {
        // Write your code here.
        for(int i=0; i<arr.length; i++){
            int a=-1;
            for(int j=i+1; j<arr.length; j++){
                if(arr[j]>arr[i]){
                    a=arr[j];
                    break;
                }
            }
            arr[i]=a;
        }
        return arr;
    }
}
