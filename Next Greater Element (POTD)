import java.util.* ;
import java.io.*; 
public class Solution 
{
    public static ArrayList<Integer> nextGreaterElement(ArrayList<Integer> arr, int n)
    {
        // Write your code here.
        ArrayList<Integer> a = new ArrayList<>();
        for(int i=0; i<n-1; i++){
            int m = -1;
            for(int j=i+1; j<n; j++){
                if(arr.get(j)>arr.get(i)){
                    m=arr.get(j);
                    break;
                }
            }
            a.add(m);
        }
        a.add(-1);
        return a;
    }
}
