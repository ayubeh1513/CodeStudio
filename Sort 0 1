public class Solution {  

    public static void sortZeroesAndOne(int[] arr) {
    	//Your code goes here
        int z = 0;
        for(int i : arr){
            if(i==0){
                z++;
            }
        }

        for(int j=0; j<arr.length; j++){
            if(j<z){
                arr[j]=0;
            } else {
                arr[j]=1;
            }
        }
    }
}
