import java.util.*;
public class Solution{  

    public static int findUnique(int[] arr){
		//Your code goes here
      Map<Integer, Integer> m = new HashMap<>();
      for(int i : arr){
        if(m.containsKey(i)){
          m.put(i, m.get(i)+1);
        } else{
          m.put(i, 1);
        }
      }

      for(int j : m.keySet()){
          if(m.get(j)==1) return j;
      }
      return -1;
    }
}
