
public class Solution {
    
    public static void swapAlternate(int arr[]) {
    	//Your code goes here
        for(int i=0; i<arr.length-1; i+=2){
            swap(arr, i, i+1);
        }
    }

    public static void swap(int[] arr, int i, int j){
        int t = arr[i];
        arr[i] = arr[j];
        arr[j] = t;
    }
}
