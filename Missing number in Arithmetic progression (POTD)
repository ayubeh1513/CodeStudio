import java.util.* ;
import java.io.*; 
public class Solution 
{
    public static int missingNumber(int[] arr, int n) 
    {
        // Write your code here
        if(n<3){
            return arr[0] + ((arr[1]-arr[0])/2);
        }
        int d1 = arr[1] - arr[0];
        int d2 = arr[2] - arr[1];

        if(d1==d2){
            int an = arr[0] + (n-1)*d1;
            int k = arr[0];
            int i = 0;
            while(k<=an){
                if(k!=arr[i]) return k;
                k+=d1;
                i++;
            }
        } else if (d1>d2) {
            return arr[1] - d2;
        } else {
            return arr[2] - d1;
        }
        return 0;
    }
}
